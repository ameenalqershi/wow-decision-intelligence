  "cli" -> "wow" [label="E02 Explicit workspace or API", tooltip="docs/design/operating-modes.md: Same local or remote bindings", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/131"];
  "erp" -> "wow" [label="E03 Staged input", tooltip="docs/design/operating-modes.md: Map authorized source schemas and units into a staged import", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/55"];
  "wow" -> "approval" [label="E04 Verified proposal", tooltip="docs/design/lifecycle.md: Only a verified feasible incumbent satisfying policy may be proposed", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/36"];
  "wow" -> "diagnostic" [label="E05 Denied or invalid input", tooltip="docs/design/tenant-threat-model.md: Missing context denies", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/12"];
