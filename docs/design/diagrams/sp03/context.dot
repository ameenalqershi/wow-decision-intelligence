  "cli" [label="CLI and SDK consumer\n#113", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "wow" [label="WOW DI decision platform\n#9", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/9"];
