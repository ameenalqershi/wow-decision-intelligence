digraph G {
  graph [rankdir=TB, bgcolor="#ffffff", pad=0.2, nodesep=0.28, ranksep=0.65, fontname="DejaVu Sans", labelloc=t, fontsize=15, label="Tenant trust boundaries — design / specification"];
  node [shape=box, style="rounded,filled", fillcolor="#e8f4f1", color="#277664", fontname="DejaVu Sans", fontsize=10, fontcolor="#18352e"];
  edge [color="#49697b", fontcolor="#263d4b", fontname="DejaVu Sans", fontsize=9, arrowsize=0.65];
  "caller" [label="Untrusted client\n#12", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/12"];
  "identity" [label="B1 Identity + authorization\n#75", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/75"];
  "store" [label="B2 Tenant services / store\n#76", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/76"];
  "source" [label="Untrusted connector peer\n#55", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/55"];
  "import" [label="B3 Staged import\n#56", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/56"];
  "worker" [label="B4 Isolated worker\n#81", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/81"];
  "verify" [label="Independent verifier\n#29", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/29"];
  "export" [label="B5 Authorized recipient\n#148", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/148"];
  "outbox" [label="B6 External write gate\n#78", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/78"];
  "target" [label="External system\n#58", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/58"];
  "ops" [label="B7 Operations domain\n#79", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/79"];
  "deny" [label="Denied / quarantine\n#12", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/12", fillcolor="#fbece7", color="#a55236", fontcolor="#78351f"];
  "caller" -> "identity" [label="E01 TLS token; untrusted body", tooltip="docs/design/tenant-threat-model.md: Validate issuer/audience/signature/lifetime", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/75"];
  "identity" -> "store" [label="E02 Authorized tenant scope", tooltip="docs/design/tenant-threat-model.md: Scoped application context", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/75"];
  "identity" -> "deny" [label="E03 Missing or foreign context", tooltip="docs/design/tenant-threat-model.md: Missing context denies", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/12"];
  "source" -> "import" [label="E04 Authorized schema import", tooltip="docs/design/tenant-threat-model.md: Authorized connector", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/55"];
  "import" -> "store" [label="E05 Validated frozen snapshot", tooltip="docs/design/tenant-threat-model.md: Validated immutable snapshot", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/56"];
  "import" -> "deny" [label="E06 Quarantine invalid import", tooltip="docs/design/tenant-threat-model.md: quarantine without advancing state", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/56"];
  "store" -> "worker" [label="E07 Fenced lease; no credentials", tooltip="docs/design/tenant-threat-model.md: Frozen input + fenced lease", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/81"];
  "worker" -> "verify" [label="E08 Untrusted candidate", tooltip="docs/design/tenant-threat-model.md: Untrusted candidate", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/29"];
  "verify" -> "store" [label="E09 Accepted evidence only", tooltip="docs/design/tenant-threat-model.md: Accepted evidence only", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/35"];
  "store" -> "export" [label="E10 Scoped authorized export", tooltip="docs/design/tenant-threat-model.md: Export authorized scope", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/148"];
  "store" -> "outbox" [label="E11 Approval + outbox; write disabled by default", tooltip="docs/design/tenant-threat-model.md: Disabled by default for financial, industrial and sensitive decisions", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/36"];
  "outbox" -> "target" [label="E12 Target-bound key / reconcile", tooltip="docs/design/tenant-threat-model.md: Target-bound key", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/58"];
  "store" -> "ops" [label="E13 Redacted telemetry / backup", tooltip="docs/design/tenant-threat-model.md: Redacted signals / encrypted backup", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/79"];
}
