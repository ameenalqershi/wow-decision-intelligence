  "benchmark" [label="benchmark run compare report\n#113", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "diagnostics" [label="doctor / config / logs / health\n#113", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "fail" [label="Usage or unsupported / stderr\n#113", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113", fillcolor="#fbece7", color="#a55236", fontcolor="#78351f"];
  "root" -> "help" [label="E01 No workspace or solver", tooltip="docs/design/cli-contract.md: Help, version and syntax validation never require network access", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "root" -> "workspace" [label="E02 API-WORKSPACE", tooltip="docs/design/cli-contract.md: init, workspace create/list/inspect/open/export", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "root" -> "model" [label="E03 API-MODEL", tooltip="docs/design/cli-contract.md: model create/validate/compile/inspect/compare/export", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "root" -> "solve" [label="E04 API-SOLVE / manifests", tooltip="docs/design/cli-contract.md: solver list/capabilities/profile", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "root" -> "graph" [label="E05 API-GRAPH", tooltip="docs/design/cli-contract.md: graph inspect/dependencies/impact/export", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "root" -> "scenario" [label="E06 API-SCENARIO", tooltip="docs/design/cli-contract.md: scenario create/compare, simulate", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
  "root" -> "evidence" [label="E07 API-EVIDENCE", tooltip="docs/design/cli-contract.md: decision verify/explain, evidence inspect/export", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
