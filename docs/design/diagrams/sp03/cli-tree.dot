digraph G {
  graph [rankdir=LR, bgcolor="#ffffff", pad=0.2, nodesep=0.28, ranksep=0.65, fontname="DejaVu Sans", labelloc=t, fontsize=15, label="CLI command families — design / specification"];
  node [shape=box, style="rounded,filled", fillcolor="#e8f4f1", color="#277664", fontname="DejaVu Sans", fontsize=10, fontcolor="#18352e"];
  edge [color="#49697b", fontcolor="#263d4b", fontname="DejaVu Sans", fontsize=9, arrowsize=0.65];
  "root" [label="wowdi\n#113", URL="https://github.com/ameenalqershi/wow-decision-intelligence/issues/113"];
